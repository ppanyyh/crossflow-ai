# CrossFlow AI V4 · LLM 增强版 — 环境变量示例
#
# 使用方法：复制本文件为 backend/.env 并填入真实值。
#   backend/.env 已被 .gitignore 忽略，不会被提交到版本库。
#
# 默认 LLM 关闭（LLM_ENABLED=false）：不填任何 Key 时，后端完全以纯 Mock
# 方式运行，回复草稿由确定性规则模板生成，LLM 接口自动回退规则模板。

# 是否启用 LLM（true / false）。默认 false。
LLM_ENABLED=false

# OpenAI 兼容 Chat Completions 服务的 Base URL（通常以 /v1 结尾）。
LLM_BASE_URL=

# API Key（严禁写入代码、README、测试或前端；仅放本地 backend/.env）。
LLM_API_KEY=

# 模型名。
LLM_MODEL=

# LLM 调用超时（秒），默认 10。
LLM_TIMEOUT_SECONDS=10
